[submodule "kotlin-klio/klio-kotlinx-io/upstream"]
	path = kotlin-klio/klio-kotlinx-io/upstream
	url = https://github.com/Kotlin/kotlinx-io
[submodule "kotlin-klio/klio-kotlinx-atomicfu/upstream"]
	path = kotlin-klio/klio-kotlinx-atomicfu/upstream
	url = https://github.com/Kotlin/kotlinx-atomicfu
[submodule "kotlin-klio/klio-kotlinx-coroutines/upstream"]
	path = kotlin-klio/klio-kotlinx-coroutines/upstream
	url = https://github.com/Kotlin/kotlinx.coroutines
[submodule "kotlin-klio/klio-kotlinx-datetime/upstream"]
	path = kotlin-klio/klio-kotlinx-datetime/upstream
	url = https://github.com/Kotlin/kotlinx-datetime
[submodule "kotlin-klio/klio-kotlinx-serialization/upstream"]
	path = kotlin-klio/klio-kotlinx-serialization/upstream
	url = https://github.com/Kotlin/kotlinx.serialization
[submodule "kotlin-klio/klio-ktor/upstream"]
	path = kotlin-klio/klio-ktor/upstream
	url = https://github.com/ktorio/ktor
# Upstream Kotlin: the interpreter reads its stdlib sources from
# kotlin/libraries/stdlib at runtime. The full repo is ~5GB, so a blanket
# `submodule update` must not pull it -- `update = none` skips it, and the
# checkout is populated as a blobless, sparse (libraries/stdlib only),
# shallow clone of the `branch` tag. See scripts/init-kotlin-submodule.sh.
[submodule "kotlin"]
	path = kotlin
	url = https://github.com/JetBrains/kotlin
	update = none
	shallow = true
	branch = v2.4.0
# Upstream Compose Multiplatform core: the compose runtime pack consumes
# androidx.compose.runtime commonMain sources verbatim. The full
# compose-multiplatform-core repo is a large androidx-derived monorepo, so a
# blanket `submodule update` must not pull it -- `update = none` skips it, and
# the checkout is a treeless, sparse (compose/runtime/runtime/src/commonMain),
# shallow clone of the pinned tag. See scripts/init-compose-submodule.sh.
[submodule "kotlin-klio/klio-compose-runtime/upstream"]
	path = kotlin-klio/klio-compose-runtime/upstream
	url = https://github.com/JetBrains/compose-multiplatform-core
	update = none
	shallow = true
	branch = v1.11.1
# Upstream androidx.collection (from the same compose-multiplatform-core fork):
# the compose runtime's common code depends on it. Treeless/sparse/shallow,
# update=none; see scripts/init-androidx-collection-submodule.sh.
[submodule "kotlin-klio/klio-androidx-collection/upstream"]
	path = kotlin-klio/klio-androidx-collection/upstream
	url = https://github.com/JetBrains/compose-multiplatform-core
	update = none
	shallow = true
	branch = v1.11.1
[submodule "kotlin-klio/klio-mosaic/upstream"]
	path = kotlin-klio/klio-mosaic/upstream
	url = https://github.com/JakeWharton/mosaic
	update = none
