[submodule "kotlin-klio/klio-kotlinx-io/upstream"]
	path = kotlin-klio/klio-kotlinx-io/upstream
	url = https://github.com/Kotlin/kotlinx-io
[submodule "kotlin-klio/klio-kotlinx-atomicfu/upstream"]
	path = kotlin-klio/klio-kotlinx-atomicfu/upstream
	url = https://github.com/Kotlin/kotlinx-atomicfu
[submodule "kotlin-klio/klio-kotlinx-coroutines/upstream"]
	path = kotlin-klio/klio-kotlinx-coroutines/upstream
	url = https://github.com/Kotlin/kotlinx.coroutines
[submodule "kotlin-klio/klio-kotlinx-datetime/upstream"]
	path = kotlin-klio/klio-kotlinx-datetime/upstream
	url = https://github.com/Kotlin/kotlinx-datetime
[submodule "kotlin-klio/klio-kotlinx-serialization/upstream"]
	path = kotlin-klio/klio-kotlinx-serialization/upstream
	url = https://github.com/Kotlin/kotlinx.serialization
[submodule "kotlin-klio/klio-ktor-client/upstream"]
	path = kotlin-klio/klio-ktor-client/upstream
	url = https://github.com/ktorio/ktor
# Upstream Kotlin: the interpreter reads its stdlib sources from
# kotlin/libraries/stdlib at runtime. The full repo is ~5GB, so a blanket
# `submodule update` must not pull it -- `update = none` skips it, and the
# checkout is populated as a blobless, sparse (libraries/stdlib only),
# shallow clone of the `branch` tag. See scripts/init-kotlin-submodule.sh.
[submodule "kotlin"]
	path = kotlin
	url = https://github.com/JetBrains/kotlin
	update = none
	shallow = true
	branch = v2.3.21
